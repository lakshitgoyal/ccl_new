<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 960 600" width="100%" height="100%">
  <defs>
    <linearGradient id="headerGrad" x1="0%" y1="0%" x2="100%" y2="0%">
      <stop offset="0%" stop-color="#FF9933" />
      <stop offset="50%" stop-color="#ffffff" />
      <stop offset="100%" stop-color="#138808" />
    </linearGradient>
    <linearGradient id="cardBg" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#ffffff" />
      <stop offset="50%" stop-color="#fcfcfd" />
      <stop offset="100%" stop-color="#f8fafc" />
    </linearGradient>
    <linearGradient id="maskBadge" x1="0%" y1="0%" x2="100%" y2="0%">
      <stop offset="0%" stop-color="#ef4444" />
      <stop offset="100%" stop-color="#dc2626" />
    </linearGradient>
    <linearGradient id="visBadge" x1="0%" y1="0%" x2="100%" y2="0%">
      <stop offset="0%" stop-color="#10b981" />
      <stop offset="100%" stop-color="#059669" />
    </linearGradient>
    <filter id="cardShadow" x="-5%" y="-5%" width="110%" height="115%">
      <feDropShadow dx="0" dy="8" stdDeviation="12" flood-color="#0f172a" flood-opacity="0.18" />
    </filter>
    <pattern id="guilloche" width="40" height="40" patternUnits="userSpaceOnUse">
      <path d="M0 20 Q 10 0, 20 20 T 40 20" fill="none" stroke="#e2e8f0" stroke-width="0.8" opacity="0.6"/>
      <path d="M20 0 Q 30 20, 40 0" fill="none" stroke="#fed7aa" stroke-width="0.5" opacity="0.4"/>
      <path d="M0 40 Q 10 20, 20 40 T 40 40" fill="none" stroke="#bbf7d0" stroke-width="0.5" opacity="0.4"/>
    </pattern>
  </defs>

  <style>
    .title-hi { font-family: 'Noto Sans Devanagari', 'Segoe UI', system-ui, sans-serif; font-size: 15px; font-weight: 700; fill: #1e293b; text-anchor: middle; }
    .title-en { font-family: system-ui, -apple-system, sans-serif; font-size: 14px; font-weight: 700; fill: #0f172a; text-anchor: middle; }
    .subtitle { font-family: system-ui, sans-serif; font-size: 11px; fill: #475569; text-anchor: middle; }
    .label { font-family: system-ui, sans-serif; font-size: 13px; fill: #64748b; font-weight: 500; }
    .val-hi { font-family: 'Noto Sans Devanagari', 'Segoe UI', system-ui, sans-serif; font-size: 15px; font-weight: 600; fill: #0f172a; }
    .val-en { font-family: system-ui, -apple-system, sans-serif; font-size: 16px; font-weight: 700; fill: #0f172a; }
    .watermark { font-family: system-ui, sans-serif; font-size: 42px; font-weight: 900; fill: #cbd5e1; opacity: 0.28; letter-spacing: 6px; }
    .aadhaar-num { font-family: 'Courier New', monospace, system-ui; font-size: 32px; font-weight: 900; letter-spacing: 4px; }
  </style>

  <!-- Outer Card Frame with subtle rounded corners & border -->
  <g filter="url(#cardShadow)">
    <rect x="25" y="25" width="910" height="550" rx="20" fill="url(#cardBg)" stroke="#cbd5e1" stroke-width="2"/>
    <rect x="25" y="25" width="910" height="550" rx="20" fill="url(#guilloche)" />
  </g>

  <!-- Specimen Diagonal Watermark -->
  <g transform="rotate(-24 480 300)">
    <text x="480" y="270" text-anchor="middle" class="watermark">SAMPLE SPECIMEN ONLY</text>
    <text x="480" y="325" text-anchor="middle" class="watermark" font-size="28">MASKED AADHAAR CARD</text>
  </g>

  <!-- Top Tricolor Ribbon -->
  <path d="M 26 43 Q 480 43 934 43" stroke="url(#headerGrad)" stroke-width="6" fill="none"/>

  <!-- Top Header Section -->
  <g transform="translate(45, 52)">
    <!-- Ashoka Lion Emblem (Stylized representation) -->
    <g transform="translate(30, 20)">
      <circle cx="20" cy="18" r="16" fill="#f1f5f9" stroke="#94a3b8" stroke-width="1.2"/>
      <path d="M12 28 L28 28 L24 36 L16 36 Z" fill="#64748b"/>
      <path d="M17 12 C17 8, 23 8, 23 12 C25 12, 27 15, 26 19 C25 24, 15 24, 14 19 C13 15, 15 12, 17 12 Z" fill="#475569"/>
      <circle cx="20" cy="20" r="3" fill="#1e293b"/>
      <text x="20" y="44" font-size="7" font-weight="bold" fill="#475569" text-anchor="middle">सत्यमेव जयते</text>
    </g>

    <!-- Header Titles -->
    <text x="435" y="22" class="title-hi">भारत सरकार</text>
    <text x="435" y="38" class="title-en">GOVERNMENT OF INDIA</text>
    <text x="435" y="52" class="subtitle">Unique Identification Authority of India (UIDAI)</text>

    <!-- Aadhaar Sun Logo -->
    <g transform="translate(760, 5)">
      <!-- Stylized Aadhaar Emblem -->
      <circle cx="36" cy="30" r="28" fill="#fff7ed" stroke="#f97316" stroke-width="1.5"/>
      <path d="M36 8 L36 14 M36 46 L36 52 M14 30 L20 30 M52 30 L58 30 M21 15 L25 19 M47 41 L51 45 M21 45 L25 41 M47 15 L51 19" stroke="#ea580c" stroke-width="2" stroke-linecap="round"/>
      <path d="M26 30 C26 23, 46 23, 46 30 C46 38, 26 38, 26 44" fill="none" stroke="#dc2626" stroke-width="2.5" stroke-linecap="round"/>
      <text x="36" y="68" font-size="9" font-weight="900" fill="#dc2626" text-anchor="middle" letter-spacing="1">आधार</text>
    </g>
  </g>

  <!-- Divider line -->
  <line x1="50" y1="135" x2="910" y2="135" stroke="#e2e8f0" stroke-width="1.5"/>

  <!-- Candidate Details & Photo -->
  <g transform="translate(60, 155)">
    <!-- Photo Box -->
    <rect x="15" y="10" width="135" height="165" rx="8" fill="#e2e8f0" stroke="#cbd5e1" stroke-width="1.5"/>
    <g transform="translate(15, 10)">
      <rect x="0" y="0" width="135" height="165" rx="8" fill="#e0f2fe"/>
      <!-- Silhouette avatar -->
      <circle cx="67" cy="62" r="30" fill="#38bdf8"/>
      <path d="M25 150 C25 110, 110 110, 110 150 Z" fill="#0284c7"/>
      <!-- Photo label badge -->
      <rect x="15" y="132" width="105" height="22" rx="4" fill="#0f172a" opacity="0.85"/>
      <text x="67" y="147" font-size="10" font-weight="bold" fill="#ffffff" text-anchor="middle">PASSPORT PHOTO</text>
    </g>

    <!-- Demographic Details -->
    <g transform="translate(180, 20)">
      <text x="0" y="15" class="label">नाम / Name:</text>
      <text x="0" y="38" class="val-hi">राहुल कुमार / RAHUL KUMAR</text>

      <text x="0" y="75" class="label">जन्म तिथि / Date of Birth:</text>
      <text x="0" y="98" class="val-en">15/07/2005</text>

      <text x="0" y="135" class="label">लिंग / Gender:</text>
      <text x="0" y="156" class="val-en">पुरुष / MALE</text>
    </g>

    <!-- QR Code Placeholder (High Tech look) -->
    <g transform="translate(640, 10)">
      <rect x="0" y="0" width="160" height="160" rx="10" fill="#ffffff" stroke="#94a3b8" stroke-width="1.5"/>
      <!-- QR corner locators -->
      <rect x="15" y="15" width="36" height="36" rx="4" fill="none" stroke="#0f172a" stroke-width="4"/>
      <rect x="23" y="23" width="20" height="20" fill="#0f172a"/>

      <rect x="109" y="15" width="36" height="36" rx="4" fill="none" stroke="#0f172a" stroke-width="4"/>
      <rect x="117" y="23" width="20" height="20" fill="#0f172a"/>

      <rect x="15" y="109" width="36" height="36" rx="4" fill="none" stroke="#0f172a" stroke-width="4"/>
      <rect x="23" y="117" width="20" height="20" fill="#0f172a"/>

      <!-- QR pattern elements -->
      <rect x="62" y="20" width="8" height="24" fill="#0f172a"/>
      <rect x="78" y="15" width="18" height="8" fill="#0f172a"/>
      <rect x="20" y="62" width="24" height="8" fill="#0f172a"/>
      <rect x="25" y="78" width="12" height="18" fill="#0f172a"/>
      <rect x="60" y="55" width="40" height="40" fill="#0f172a"/>
      <rect x="68" y="63" width="24" height="24" fill="#ffffff"/>
      <rect x="74" y="69" width="12" height="12" fill="#0f172a"/>
      <rect x="115" y="65" width="12" height="25" fill="#0f172a"/>
      <rect x="135" y="70" width="10" height="15" fill="#0f172a"/>
      <rect x="65" y="110" width="25" height="10" fill="#0f172a"/>
      <rect x="105" y="105" width="40" height="12" fill="#0f172a"/>
      <rect x="120" y="125" width="25" height="20" fill="#0f172a"/>
      <rect x="65" y="130" width="15" height="15" fill="#0f172a"/>

      <!-- Secure Aadhaar QR Label -->
      <rect x="15" y="165" width="130" height="16" rx="3" fill="#f1f5f9"/>
      <text x="80" y="177" font-size="9" font-weight="bold" fill="#475569" text-anchor="middle">SECURE QR CODE</text>
    </g>
  </g>

  <!-- MASKED AADHAAR NUMBER HIGHLIGHT SECTION -->
  <g transform="translate(60, 360)">
    <!-- Container Card for Aadhaar Number -->
    <rect x="15" y="0" width="810" height="105" rx="14" fill="#ffffff" stroke="#cbd5e1" stroke-width="2"/>
    <rect x="15" y="0" width="810" height="105" rx="14" fill="#f8fafc" opacity="0.6"/>

    <!-- Masked First 8 Digits Box (Red / Guarded highlight) -->
    <g transform="translate(50, 18)">
      <rect x="0" y="0" width="370" height="52" rx="8" fill="#fef2f2" stroke="#f87171" stroke-width="2" stroke-dasharray="4 4"/>
      <text x="185" y="37" text-anchor="middle" class="aadhaar-num" fill="#dc2626">XXXX  XXXX</text>

      <!-- Badge for first 8 digits -->
      <rect x="40" y="58" width="290" height="22" rx="11" fill="url(#maskBadge)"/>
      <text x="185" y="73" font-size="11" font-weight="bold" fill="#ffffff" text-anchor="middle">
        🛡️ FIRST 8 DIGITS MASKED / HIDDEN
      </text>
    </g>

    <!-- Visible Last 4 Digits Box (Green / Visible highlight) -->
    <g transform="translate(450, 18)">
      <rect x="0" y="0" width="220" height="52" rx="8" fill="#f0fdf4" stroke="#22c55e" stroke-width="2.5"/>
      <text x="110" y="37" text-anchor="middle" class="aadhaar-num" fill="#15803d">5482</text>

      <!-- Badge for last 4 digits -->
      <rect x="15" y="58" width="190" height="22" rx="11" fill="url(#visBadge)"/>
      <text x="110" y="73" font-size="11" font-weight="bold" fill="#ffffff" text-anchor="middle">
        ✓ ONLY LAST 4 VISIBLE
      </text>
    </g>

    <!-- Lock icon on right -->
    <g transform="translate(710, 22)">
      <circle cx="28" cy="28" r="24" fill="#eff6ff" stroke="#3b82f6" stroke-width="1.5"/>
      <!-- Shield checkmark -->
      <path d="M28 14 L39 19 C39 30, 28 39, 28 41 C28 39, 17 30, 17 19 Z" fill="#2563eb"/>
      <path d="M23 26 L27 30 L34 22" fill="none" stroke="#ffffff" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
      <text x="28" y="65" font-size="9" font-weight="bold" fill="#1d4ed8" text-anchor="middle">UIDAI VERIFIED</text>
    </g>
  </g>

  <!-- Bottom Identity Motto & Official Tag -->
  <g transform="translate(50, 500)">
    <!-- Red Accent line -->
    <line x1="25" y1="0" x2="835" y2="0" stroke="#dc2626" stroke-width="2"/>
    <text x="430" y="24" font-family="'Noto Sans Devanagari', 'Segoe UI', sans-serif" font-size="17" font-weight="800" fill="#dc2626" text-anchor="middle">
      मेरा आधार, मेरी पहचान
    </text>
    <text x="430" y="44" font-family="system-ui, sans-serif" font-size="11" font-weight="600" fill="#475569" text-anchor="middle">
      Example of Official Masked Aadhaar Card Specimen (Required for Champion Cricket League Verification)
    </text>
  </g>
</svg>
